{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "svp",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd /Users/Region3/School-Visit-Planning-YMU && npm run dev -- -p 3001"
      ],
      "port": 3001
    },
    {
      "name": "svp-prod",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd /Users/Region3/School-Visit-Planning-YMU && npm run build && npm run start -- -p 3002"
      ],
      "port": 3002
    }
  ]
}
